# Copy this file to ".env" and fill in your own values. Never commit ".env".

# Easy local setup uses SQLite automatically. For PostgreSQL, replace this value with your connection URL.
DATABASE_URL=sqlite:///./smarttwin.db

# Where uploaded files go: "s3" (real Amazon S3) or "local" (a folder on your PC, for development only)
STORAGE_MODE=local

# Needed when STORAGE_MODE=s3
S3_BUCKET_NAME=
AWS_REGION=ap-south-1
# NOTE: do NOT put AWS access keys here. On EC2 the IAM role supplies credentials automatically.

# Frontend addresses allowed to call this API (comma separated)
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# Largest upload allowed, in megabytes
MAX_UPLOAD_MB=5
